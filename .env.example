# Public application URL. Change after deployment.
#NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.sthelp.edu.lk
# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Admin login
ADMIN_USERNAME=nadeemal
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_HASH
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Used to hash client access PINs
PIN_HASH_SECRET=replace-with-another-long-random-secret

# PayHere Checkout API (server-side values; never prefix the secret with NEXT_PUBLIC_)
# Sandbox and Live use separate accounts/credentials. For production, use the
# secret shown for your approved domain, set PAYHERE_MODE=live and enable only
# after the PayHere ledger migration has been applied. Keep credentials present
# if PAYHERE_ENABLED is later set to false so delayed callbacks remain verifiable.
PAYHERE_ENABLED=false
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=YOUR_PAYHERE_MERCHANT_ID
PAYHERE_MERCHANT_SECRET=YOUR_DOMAIN_SPECIFIC_PAYHERE_MERCHANT_SECRET

# Free Email Notifications (When assignments are submitted)
# Option 1: Free Gmail SMTP (Use standard Gmail address with 16-character App Password)
# GMAIL_USER=yourbusiness@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option 2: Custom Domain / Webmail / Brevo SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourbusiness@gmail.com
# SMTP_PASS=your_app_password_or_smtp_password
# SMTP_FROM="StHelp Academic Support" <yourbusiness@gmail.com>

# Option 3: Resend (Free 3,000 emails/month)
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Admin notification recipient (defaults to settings.business_email or SMTP_USER)
# ADMIN_NOTIFICATION_EMAIL=your_personal_or_admin_email@gmail.com

