# Public application URL. Change after deployment.
#NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://www.sthelp.edu.lk
# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Admin login
ADMIN_USERNAME=nadeemal
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_HASH
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Used to hash client access PINs
PIN_HASH_SECRET=replace-with-another-long-random-secret

# PayHere Checkout API (server-side values; never prefix the secret with NEXT_PUBLIC_)
# Leave disabled until PayHere approves the account and your production domain.
PAYHERE_ENABLED=false
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=YOUR_PAYHERE_MERCHANT_ID
PAYHERE_MERCHANT_SECRET=YOUR_DOMAIN_SPECIFIC_PAYHERE_MERCHANT_SECRET
